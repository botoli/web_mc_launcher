{
  "name": "minecraft-launcher-server",
  "version": "2.0.0",
  "description": "Minecraft Launcher Server — управление сборкой, модами, игроками",
  "main": "apps/api/src/server.js",
  "scripts": {
    "dev": "node scripts/run.js dev",
    "build": "node scripts/build-error-pages.js && next build apps/web",
    "start": "node scripts/run.js start",
    "start:backend": "node apps/api/src/server.js",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --test tests/error-pages.test.js tests/network.test.js tests/configs.test.js tests/database.test.js tests/telegram-auth.test.js tests/player-services.test.js tests/player-table.test.js tests/log-filters.test.js tests/web-api.test.js tests/navigation.test.js tests/launcher-release.test.js tests/player-site.test.js tests/integration.test.js",
    "test:player-site": "node --test tests/player-site.test.js",
    "test:telegram": "node --test tests/telegram-auth.test.js",
    "test:navigation": "node --test tests/navigation.test.js",
    "start:bot": "node apps/bot/bot.js",
    "db:migrate": "node scripts/db/migrate-postgres.js",
    "db:verify": "node scripts/db/migrate-postgres.js --verify",
    "test:database": "node --test tests/database.test.js",
    "db:backup": "node scripts/db/backup-postgres.js",
    "test:errors": "node --test tests/error-pages.test.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@next/env": "^16.4.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "buffer-crc32": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "express-fileupload": "^1.5.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
