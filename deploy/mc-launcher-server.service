[Unit]
Description=Minecraft Launcher Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mc-launcher/web_mc_launcher
ExecStart=/usr/bin/node /opt/mc-launcher/web_mc_launcher/scripts/run.js start
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
