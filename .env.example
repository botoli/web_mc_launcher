PORT=3000
HOST=127.0.0.1
FRONTEND_PORT=3001
DOMAIN=localhost
USE_HTTPS=false
HTTPS_PORT=3443
# Behind Nginx: set PUBLIC_URL=https://your-domain.example and HTTPS_ENABLED=false.
# Public HTTPS controls generated URLs and Secure cookies independently of internal TLS.
# PUBLIC_URL=https://your-domain.example
HTTPS_ENABLED=false
TRUST_PROXY=loopback
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_SECRET=replace-with-a-long-random-shared-bot-secret
PLAYER_EVENTS_SECRET=replace-with-a-long-random-service-secret

# PostgreSQL. DATABASE_URL, if provided, takes precedence over these values.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mc_launcher
PGUSER=mc_launcher
PGPASSWORD=replace-with-the-database-password
# Optional: defaults to public. Tests create separate mc_test_* schemas.
# PGSCHEMA=public
# DATABASE_URL=postgresql://mc_launcher:URL_ENCODED_PASSWORD@127.0.0.1:5432/mc_launcher
