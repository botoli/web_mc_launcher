<% title = 'Вход'; currentPath = '/login'; %>
<%- include('partials/header', { title, currentPath }) %>

<div class="container">
    <div class="card">
        <h1>🔐 Вход</h1>
        <h2>Войдите в свой аккаунт лаунчера</h2>

        <% if (typeof error === 'string' && error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form id="loginForm" onsubmit="handleLogin(event)">
            <div class="form-group">
                <label for="login">Логин</label>
                <input type="text" id="login" name="login" placeholder="Введите логин" minlength="3" required autocomplete="username">
            </div>
            <div class="form-group">
                <label for="password">Пароль</label>
                <input type="password" id="password" name="password" placeholder="Введите пароль" minlength="4" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn-primary" id="submitBtn">Войти</button>
        </form>
        <div class="footer-text" style="margin-top: 20px;">
            Нет аккаунта? <a href="/register">Зарегистрироваться</a>
        </div>
    </div>
    <div class="footer-text">
        Minecraft Launcher © 2026 | <a href="/">Панель управления</a>
    </div>
</div>

<script>
async function handleLogin(e) {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    const login = document.getElementById('login').value.trim();
    const password = document.getElementById('password').value;

    btn.disabled = true;
    btn.textContent = 'Вход...';

    try {
        const res = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login, password })
        });
        const data = await res.json();

        if (data.success) {
            const redirect = new URLSearchParams(window.location.search).get('redirect') || '/profile';
            window.location.href = redirect;
        } else {
            const alertEl = document.createElement('div');
            alertEl.className = 'alert alert-error';
            alertEl.textContent = data.error || 'Ошибка входа';
            const form = document.getElementById('loginForm');
            form.parentNode.insertBefore(alertEl, form);
            btn.disabled = false;
            btn.textContent = 'Войти';
        }
    } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Войти';
        alert('Ошибка соединения с сервером');
    }
}
</script>
</body>
</html>