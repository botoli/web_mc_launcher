<% title = 'Панель управления'; currentPath = '/'; %>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minecraft Launcher — Панель управления</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #0d1117; color: #c9d1d9; min-height: 100vh; }
        nav {
            background: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 0 24px;
            display: flex;
            align-items: center;
            height: 56px;
        }
        nav .logo { font-size: 18px; font-weight: 700; color: #58a6ff; margin-right: 32px; text-decoration: none; }
        .container { max-width: 1100px; margin: 0 auto; padding: 20px; }
        h1 { color: #58a6ff; margin-bottom: 10px; }
        h2 { color: #8b949e; font-size: 16px; margin-bottom: 20px; }
        .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
        .card h3 { color: #58a6ff; margin-bottom: 15px; }
        .status { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 20px; }
        .status-item { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 15px; flex: 1; min-width: 130px; text-align: center; }
        .status-item .label { color: #8b949e; font-size: 12px; text-transform: uppercase; }
        .status-item .value { color: #58a6ff; font-size: 24px; font-weight: bold; margin-top: 5px; }
        .status-item .green { color: #3fb950; }
        .btn { background: #238636; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2ea043; }
        .btn.danger { background: #da3633; }
        .btn.danger:hover { background: #f85149; }
        .btn.small { padding: 5px 10px; font-size: 12px; }
        .btn.warn { background: #d2991d; }
        .btn.warn:hover { background: #e2a926; }
        input, select { background: #0d1117; border: 1px solid #30363d; color: #c9d1d9; padding: 8px 12px; border-radius: 6px; width: 100%; margin-bottom: 10px; font-size: 14px; }
        .form-row { display: flex; gap: 10px; }
        .form-row > * { flex: 1; }
        .mod-list { margin-top: 10px; }
        .mod-item { display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #30363d; }
        .mod-item:last-child { border-bottom: none; }
        .mod-item .name { color: #7ee787; font-family: monospace; }
        .result { margin-top: 10px; padding: 10px; border-radius: 6px; display: none; }
        .result.success { background: #033a16; color: #3fb950; display: block; }
        .result.error { background: #3a0303; color: #f85149; display: block; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #30363d; }
        th { color: #8b949e; font-weight: 600; font-size: 12px; text-transform: uppercase; }
        td { font-size: 14px; }
        .note { color: #8b949e; font-size: 12px; margin-top: 5px; }
        code { background: #0d1117; padding: 2px 6px; border-radius: 4px; font-family: monospace; }

        /* Tabs */
        .tabs { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 1px solid #30363d; padding-bottom: 0; }
        .tab-btn {
            background: transparent;
            border: none;
            color: #8b949e;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            border-bottom: 2px solid transparent;
            transition: all 0.15s;
            font-family: inherit;
        }
        .tab-btn:hover { color: #c9d1d9; }
        .tab-btn.active { color: #58a6ff; border-bottom-color: #58a6ff; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .badge-status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }
        .badge-confirmed { background: #033a16; color: #3fb950; }
        .badge-pending { background: #3a2e03; color: #d2991d; }
        .badge-banned { background: #3a0303; color: #f85149; }

        .status-select {
            background: #0d1117;
            border: 1px solid #30363d;
            color: #c9d1d9;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
        }
        .players-table td { vertical-align: middle; }
    </style>
</head>
<body>
<nav>
    <a href="/" class="logo">🎮 Minecraft Launcher — Панель управления</a>
</nav>

<div class="container">
    <h1>🎮 Панель управления v2.0</h1>
    <h2>Сервер: <code><%= mcServer %></code> | Домен: <code><%= domain %></code></h2>

    <div class="status">
        <div class="status-item">
            <div class="label">Статус</div>
            <div class="value green">ONLINE</div>
        </div>
        <div class="status-item">
            <div class="label">Игроков</div>
            <div class="value"><%= userCount %></div>
        </div>
        <div class="status-item">
            <div class="label">Модов</div>
            <div class="value"><%= mods.length %></div>
        </div>
        <div class="status-item">
            <div class="label">Сборка</div>
            <div class="value" style="font-size:14px;"><%= buildConfig.version %> <%= buildConfig.loader %></div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('build')">⚙️ Сборка</button>
        <button class="tab-btn" onclick="switchTab('mods')">📦 Моды</button>
        <button class="tab-btn" onclick="switchTab('players')">👥 Игроки</button>
    </div>

    <!-- Tab: Build -->
    <div class="tab-content active" id="tab-build">
        <div class="card">
            <h3>⚙️ Текущая сборка (меняется мгновенно для клиентов)</h3>
            <div class="form-row">
                <select id="version">
                    <% versions.forEach(v => { %>
                        <option <%= v === buildConfig.version ? 'selected' : '' %>><%= v %></option>
                    <% }); %>
                </select>
                <select id="loader">
                    <% loaders.forEach(l => { %>
                        <option <%= l === buildConfig.loader ? 'selected' : '' %>><%= l %></option>
                    <% }); %>
                </select>
                <input type="text" id="loaderVersion" placeholder="Версия загрузчика" value="<%= buildConfig.loaderVersion %>">
            </div>
            <div class="form-row">
                <input type="number" id="minMemory" placeholder="Мин. RAM (MB)" value="<%= buildConfig.minMemory %>">
                <input type="number" id="maxMemory" placeholder="Макс. RAM (MB)" value="<%= buildConfig.maxMemory %>">
                <input type="text" id="serverIP" placeholder="IP:Port MC сервера" value="<%= buildConfig.servers?.[0]?.address || '' %>">
            </div>
            <button class="btn" onclick="updateBuildConfig()">💾 Сохранить сборку</button>
            <div class="result" id="buildResult"></div>
            <p class="note">После сохранения — все клиенты при следующем запуске получат новые параметры.</p>
        </div>
    </div>

    <!-- Tab: Mods -->
    <div class="tab-content" id="tab-mods">
        <div class="card">
            <h3>📦 Загрузка мода (.jar)</h3>
            <input type="file" id="modFile" accept=".jar">
            <button class="btn" onclick="uploadMod()">Загрузить</button>
            <div class="result" id="modResult"></div>

            <div class="mod-list">
                <h4 style="color:#8b949e; margin:15px 0 10px;">Установленные моды (клиенты авто-синхронизируются):</h4>
                <% if (mods.length === 0) { %>
                    <p style="color:#484f58;">Модов пока нет. Загрузите первый!</p>
                <% } %>
                <% mods.forEach(mod => { %>
                    <div class="mod-item">
                        <span class="name"><%= mod %></span>
                        <button class="btn danger small" onclick="deleteMod(this)" data-mod="<%= mod %>">Удалить</button>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Tab: Players -->
    <div class="tab-content" id="tab-players">
        <div class="card">
            <h3>👥 Зарегистрированные игроки</h3>
            <table class="players-table" id="playersTable">
                <thead>
                    <tr>
                        <th>Логин</th>
                        <th>Никнейм</th>
                        <th>Email</th>
                        <th>Статус</th>
                        <th>Дата регистрации</th>
                        <th>Последний вход</th>
                        <th>Изменить статус</th>
                    </tr>
                </thead>
                <tbody id="playersBody">
                    <tr><td colspan="7" style="text-align:center; color:#484f58;">Загрузка...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Links -->
    <div class="card">
        <h3>🔗 Ссылки</h3>
        <p class="note">Сайт для игроков: <a href="<%= publicURL %>/login" style="color:#58a6ff;"><%= publicURL %>/login</a></p>
        <p class="note">API билда: <code>GET /api/client-config</code> (публичный)</p>
        <p class="note">Моды: <code>GET /api/download-mods</code> (публичный)</p>
    </div>
</div>

<script>
// ==================== Tabs ====================
function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.querySelector(`.tab-btn[onclick="switchTab('${name}')"]`).classList.add('active');
    document.getElementById('tab-' + name).classList.add('active');
    if (name === 'players') loadPlayers();
}

// ==================== Build Config ====================
async function updateBuildConfig() {
    const version = document.getElementById('version').value;
    const loader = document.getElementById('loader').value;
    const loaderVersion = document.getElementById('loaderVersion').value;
    const minMemory = document.getElementById('minMemory').value;
    const maxMemory = document.getElementById('maxMemory').value;
    const serverIP = document.getElementById('serverIP').value;
    const res = await fetch('/api/build-config', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ version, loader, loaderVersion, minMemory, maxMemory, serverIP })
    });
    const data = await res.json();
    showResult('buildResult', data.success ? 'success' : 'error', data.success ? 'Сборка обновлена! Клиенты получат изменения.' : data.error);
}

// ==================== Mods ====================
async function uploadMod() {
    const file = document.getElementById('modFile').files[0];
    if (!file) return showResult('modResult', 'error', 'Выберите файл');
    const formData = new FormData();
    formData.append('mod', file);
    const res = await fetch('/api/upload-mod', { method: 'POST', body: formData });
    const data = await res.json();
    showResult('modResult', data.error ? 'error' : 'success', data.error || `${data.name} загружен!`);
    if (data.success) setTimeout(() => location.reload(), 1000);
}

async function deleteMod(elOrName) {
    const name = typeof elOrName === 'string' ? elOrName : elOrName.getAttribute('data-mod');
    if (!confirm(`Удалить ${name}?`)) return;
    const res = await fetch('/api/delete-mod', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
    });
    const data = await res.json();
    if (data.success) location.reload();
}

// ==================== Players ====================
async function loadPlayers() {
    const tbody = document.getElementById('playersBody');
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:#8b949e;">Загрузка...</td></tr>';

    try {
        const res = await fetch('/api/admin/players');
        const players = await res.json();

        if (players.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:#484f58;">Нет зарегистрированных игроков</td></tr>';
            return;
        }

        tbody.innerHTML = '';
        players.forEach(p => {
            const statusClass = {
                'confirmed': 'badge-confirmed',
                'pending': 'badge-pending',
                'banned': 'badge-banned'
            }[p.registrationStatus] || '';

            const statusLabel = {
                'confirmed': '✅ Подтверждён',
                'pending': '⏳ Ожидает',
                'banned': '🚫 Заблокирован'
            }[p.registrationStatus] || p.registrationStatus;

            const row = tbody.insertRow();
            row.innerHTML = `
                <td><strong>${esc(p.login)}</strong></td>
                <td>${esc(p.nickname)}</td>
                <td>${esc(p.email !== '—' ? p.email : '—')}</td>
                <td><span class="badge-status ${statusClass}">${statusLabel}</span></td>
                <td>${p.registeredAt ? new Date(p.registeredAt).toLocaleString('ru-RU') : '—'}</td>
                <td>${p.lastLogin ? new Date(p.lastLogin).toLocaleString('ru-RU') : 'Никогда'}</td>
                <td>
                    <select class="status-select" id="status-${esc(p.login)}" onchange="changePlayerStatus('${esc(p.login)}')">
                        <option value="confirmed" ${p.registrationStatus === 'confirmed' ? 'selected' : ''}>Подтверждён</option>
                        <option value="pending" ${p.registrationStatus === 'pending' ? 'selected' : ''}>Ожидает</option>
                        <option value="banned" ${p.registrationStatus === 'banned' ? 'selected' : ''}>Заблокирован</option>
                    </select>
                </td>
            `;
        });
    } catch (err) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:#f85149;">Ошибка загрузки игроков</td></tr>';
    }
}

async function changePlayerStatus(login) {
    const select = document.getElementById('status-' + login);
    const status = select.value;
    try {
        const res = await fetch(`/api/admin/players/${encodeURIComponent(login)}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        });
        const data = await res.json();
        if (data.success) {
            loadPlayers(); // Refresh
        } else {
            alert(data.error || 'Ошибка');
            loadPlayers();
        }
    } catch (err) {
        alert('Ошибка соединения');
        loadPlayers();
    }
}

function esc(s) {
    return String(s).replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>').replace(/"/g, '"').replace(/'/g, '&#39;');
}

function showResult(id, type, msg) {
    const el = document.getElementById(id);
    el.className = `result ${type}`;
    el.textContent = msg;
}
</script>
</body>
</html>