<% if (typeof currentPath === 'undefined') { currentPath = '/'; } %>
<% if (typeof title === 'undefined') { title = 'Minecraft Launcher'; } %>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — Minecraft Launcher</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #0d1117;
            color: #c9d1d9;
            min-height: 100vh;
        }
        nav {
            background: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 0 24px;
            display: flex;
            align-items: center;
            height: 56px;
        }
        nav .logo {
            font-size: 18px;
            font-weight: 700;
            color: #58a6ff;
            margin-right: 32px;
            text-decoration: none;
        }
        nav .logo span { margin-right: 6px; }
        nav .links { display: flex; gap: 8px; flex: 1; }
        nav .links a {
            color: #8b949e;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.15s;
        }
        nav .links a:hover { color: #c9d1d9; background: #21262d; }
        nav .links a.active { color: #58a6ff; background: #1f2937; }
        nav .user-area { display: flex; align-items: center; gap: 12px; }
        nav .user-area .username { color: #c9d1d9; font-size: 14px; }
        nav .user-area .btn-logout {
            background: #21262d;
            border: 1px solid #30363d;
            color: #8b949e;
            padding: 6px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.15s;
        }
        nav .user-area .btn-logout:hover { color: #f85149; border-color: #da3633; }
        .container { max-width: 640px; margin: 0 auto; padding: 40px 20px; }
        .card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 32px;
        }
        .card h1 { font-size: 24px; color: #fff; margin-bottom: 8px; }
        .card h2 { font-size: 16px; color: #8b949e; font-weight: 400; margin-bottom: 24px; }
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block;
            font-size: 13px;
            color: #8b949e;
            margin-bottom: 6px;
            font-weight: 500;
        }
        .form-group input {
            width: 100%;
            padding: 10px 14px;
            background: #0d1117;
            border: 1px solid #30363d;
            border-radius: 8px;
            color: #c9d1d9;
            font-size: 15px;
            font-family: inherit;
            outline: none;
            transition: border 0.15s;
        }
        .form-group input:focus { border-color: #58a6ff; }
        .btn-primary {
            width: 100%;
            padding: 12px;
            background: #238636;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-primary:hover { background: #2ea043; }
        .btn-primary:disabled { background: #21262d; color: #484f58; cursor: not-allowed; }
        .alert {
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }
        .alert-error { background: #3a0303; border: 1px solid #f85149; color: #f85149; }
        .alert-success { background: #033a16; border: 1px solid #3fb950; color: #3fb950; }
        .footer-text {
            text-align: center;
            margin-top: 24px;
            font-size: 12px;
            color: #484f58;
        }
        .footer-text a { color: #58a6ff; text-decoration: none; }
        .footer-text a:hover { text-decoration: underline; }
        .form-note { font-size: 12px; color: #484f58; margin-top: 4px; }
    </style>
</head>
<body>
<nav>
    <a href="/" class="logo"><span>🎮</span>Minecraft Launcher</a>
    <div class="links">
        <% if (typeof user !== 'undefined' && user) { %>
            <a href="/profile" class="<%= currentPath === '/profile' ? 'active' : '' %>">👤 Профиль</a>
        <% } else { %>
            <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>">Вход</a>
            <a href="/register" class="<%= currentPath === '/register' ? 'active' : '' %>">Регистрация</a>
        <% } %>
    </div>
    <div class="user-area">
        <% if (typeof user !== 'undefined' && user) { %>
            <span class="username"><%= user.login %></span>
            <form action="/api/logout" method="POST" style="display:inline;" id="logoutForm">
                <button type="button" class="btn-logout" onclick="doLogout()">Выйти</button>
            </form>
        <% } %>
    </div>
</nav>

<script>
async function doLogout() {
    await fetch('/api/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    window.location.href = '/login';
}
</script>